{
  // Para cuando abres la carpeta `libretapp/` directamente en VS Code.
  // Si abres la carpeta raíz `LibretApp/`, el que manda es ../.vscode/launch.json
  // — VS Code solo lee el launch.json de la carpeta que tengas abierta.
  //
  // Las credenciales viven en dart_define.local.json, que está en .gitignore.
  // Copia dart_define.example.json si te falta.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "libretapp (con respaldo en la nube)",
      "request": "launch",
      "type": "dart",
      "args": ["--dart-define-from-file=dart_define.local.json"]
    },
    {
      "name": "libretapp (solo local, sin nube)",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "libretapp (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "args": ["--dart-define-from-file=dart_define.local.json"]
    },
    {
      "name": "libretapp (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": ["--dart-define-from-file=dart_define.local.json"]
    }
  ]
}
